# Proveedor de IA: qwen (local) o gemini (Google Gemini API)
AI_PROVIDER=qwen

# Qwen / compatible OpenAI API
QWEN_API_KEY=replace_me
QWEN_MODEL=qwen3.8-max
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Gemini API
# Para la prueba en CT105: crear la clave en Google AI Studio y ponerla SOLO en el .coach.env del servidor.
GEMINI_API_KEY=replace_me
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
