from __future__ import annotations

from datetime import datetime, timezone
import uuid


ONBOARDING_VERSION = 1


def utc_now_iso() -> str:
    return datetime.now(timezone.utc).isoformat()


def create_onboarding_id() -> str:
    return str(uuid.uuid4())


# Programa inicial común para usuarios nuevos.
#
# Criterios:
# - 3 sesiones de cuerpo completo.
# - Prioridad adicional a glúteos y tren inferior.
# - Volumen moderado para una persona principiante.
# - RIR 2 en todas las series.
# - Progresión compatible con el catálogo existente.
#
# El programa utiliza nombres de ejercicios y no UUIDs para que los
# identificadores reales se resuelvan contra la tabla exercises.
INITIAL_PROGRAM = {
    "A": [
        ("Hip thrust", 1, 3, 8, 10, 2, 120, 0),
        ("Prensa de piernas", 2, 3, 8, 10, 2, 150, 0),
        ("Press de hombro con mancuernas agarre neutro", 3, 2, 8, 10, 2, 120, 0),
        ("Jalón al pecho agarre neutro", 4, 2, 8, 10, 2, 120, 0),
        ("Curl femoral", 5, 2, 10, 12, 2, 90, 0),
        ("Extensión de tríceps en polea", 6, 2, 10, 12, 2, 75, 0),
    ],
    "B": [
        ("Sentadilla búlgara", 1, 3, 8, 10, 2, 120, 0),
        ("Hip thrust", 2, 3, 8, 10, 2, 120, 0),
        ("Press inclinado con mancuernas 30 grados", 3, 2, 8, 10, 2, 120, 0),
        ("Remo unilateral con mancuerna", 4, 2, 10, 12, 2, 90, 0),
        ("Elevaciones laterales en máquina", 5, 2, 12, 15, 2, 75, 0),
        ("Curl de bíceps en máquina", 6, 2, 10, 12, 2, 75, 0),
    ],
    "C": [
        ("Prensa de piernas", 1, 3, 8, 10, 2, 150, 0),
        ("Zancadas", 2, 2, 8, 10, 2, 120, 0),
        ("Curl femoral", 3, 2, 10, 12, 2, 90, 0),
        ("Press banca plano", 4, 2, 8, 10, 2, 120, 0),
        ("Remo con pecho apoyado", 5, 2, 8, 10, 2, 120, 0),
        ("Elevaciones laterales en máquina", 6, 2, 12, 15, 2, 75, 0),
    ],
}


def get_onboarding_status(conn, user_id: str) -> dict:
    row = conn.execute(
        """
        SELECT
            user_id,
            onboarding_version,
            completed_at
        FROM user_onboarding
        WHERE user_id = ?
        """,
        (user_id,),
    ).fetchone()

    if row is None:
        return {
            "required": True,
            "completed": False,
            "version": ONBOARDING_VERSION,
            "completed_at": None,
        }

    completed = (
        row["onboarding_version"] >= ONBOARDING_VERSION
        and row["completed_at"] is not None
    )

    return {
        "required": not completed,
        "completed": completed,
        "version": row["onboarding_version"],
        "completed_at": row["completed_at"],
    }


def _get_user_routine_count(conn, user_id: str) -> int:
    row = conn.execute(
        """
        SELECT COUNT(*) AS count
        FROM routines
        WHERE user_id = ?
        """,
        (user_id,),
    ).fetchone()

    return int(row["count"])


def _get_exercise_ids(conn) -> dict[str, str]:
    rows = conn.execute(
        """
        SELECT id, name
        FROM exercises
        WHERE is_active = 1
        """
    ).fetchall()

    return {row["name"]: row["id"] for row in rows}


def _create_initial_program(conn, user_id: str) -> list[str]:
    """
    Crea el programa inicial únicamente si el usuario no tiene rutinas.

    Esto hace que la operación sea idempotente:
    - usuario nuevo -> crea A/B/C;
    - usuario con rutinas -> no toca nada;
    - repetir la operación -> no duplica rutinas.
    """

    if _get_user_routine_count(conn, user_id) > 0:
        return []

    exercise_ids = _get_exercise_ids(conn)

    # Validamos todo el catálogo antes de insertar nada.
    missing = sorted(
        {
            exercise_name
            for routine in INITIAL_PROGRAM.values()
            for exercise_name, *_ in routine
            if exercise_name not in exercise_ids
        }
    )

    if missing:
        raise ValueError(
            "Faltan ejercicios del catálogo para el programa inicial: "
            + ", ".join(missing)
        )

    created_routines: list[str] = []

    for day_order, routine_name in enumerate(("A", "B", "C"), start=1):
        routine_id = str(uuid.uuid4())

        conn.execute(
            """
            INSERT INTO routines (
                id,
                user_id,
                name,
                day_order,
                is_active
            )
            VALUES (?, ?, ?, ?, 1)
            """,
            (
                routine_id,
                user_id,
                routine_name,
                day_order,
            ),
        )

        for (
            exercise_name,
            order,
            target_sets,
            target_rep_min,
            target_rep_max,
            target_rir,
            rest_seconds,
            is_optional,
        ) in INITIAL_PROGRAM[routine_name]:

            conn.execute(
                """
                INSERT INTO routine_exercises (
                    id,
                    routine_id,
                    exercise_id,
                    "order",
                    target_sets,
                    target_rep_min,
                    target_rep_max,
                    target_rir,
                    rest_seconds,
                    is_optional
                )
                VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
                """,
                (
                    str(uuid.uuid4()),
                    routine_id,
                    exercise_ids[exercise_name],
                    order,
                    target_sets,
                    target_rep_min,
                    target_rep_max,
                    target_rir,
                    rest_seconds,
                    is_optional,
                ),
            )

        created_routines.append(routine_id)

    return created_routines


def complete_onboarding(conn, user_id: str) -> dict:
    """
    Completa el onboarding y, si el usuario no tiene rutinas,
    crea automáticamente su programa inicial.

    La transacción se confirma solamente cuando ambas operaciones
    han terminado correctamente.
    """

    now = utc_now_iso()

    # Si ya estaba completado, no volvemos a crear ni modificar nada.
    existing = conn.execute(
        """
        SELECT onboarding_version, completed_at
        FROM user_onboarding
        WHERE user_id = ?
        """,
        (user_id,),
    ).fetchone()

    if (
        existing is not None
        and existing["onboarding_version"] >= ONBOARDING_VERSION
        and existing["completed_at"] is not None
    ):
        return get_onboarding_status(conn, user_id)

    _create_initial_program(conn, user_id)

    conn.execute(
        """
        INSERT INTO user_onboarding (
            id,
            user_id,
            onboarding_version,
            completed_at,
            created_at,
            updated_at
        )
        VALUES (?, ?, ?, ?, ?, ?)
        ON CONFLICT(user_id)
        DO UPDATE SET
            onboarding_version = excluded.onboarding_version,
            completed_at = excluded.completed_at,
            updated_at = excluded.updated_at
        """,
        (
            create_onboarding_id(),
            user_id,
            ONBOARDING_VERSION,
            now,
            now,
            now,
        ),
    )

    conn.commit()

    return get_onboarding_status(conn, user_id)


def reset_onboarding(conn, user_id: str) -> dict:
    """
    Reinicia solamente el estado del onboarding.

    No elimina las rutinas del usuario.
    """

    conn.execute(
        """
        DELETE FROM user_onboarding
        WHERE user_id = ?
        """,
        (user_id,),
    )

    conn.commit()

    return get_onboarding_status(conn, user_id)
