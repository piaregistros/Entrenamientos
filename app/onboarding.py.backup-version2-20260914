import json

from .training_assessment import (
    ASSESSMENT_VERSION,
    build_training_profile,
    select_program,
    explain_selection,
)

from .training_engine import (
    generate_engine_program,
)



def _get_active_exercise_catalog(conn) -> list[dict]:
    """
    Devuelve el catálogo activo en el formato que espera el motor.
    """
    rows = conn.execute(
        """
        SELECT *
        FROM exercises
        WHERE is_active = 1
        ORDER BY name
        """
    ).fetchall()

    return [dict(row) for row in rows]


def _create_engine_program(
    conn,
    user_id: str,
    profile: dict,
) -> list[str]:
    """
    Genera y persiste el programa V2.

    Seguridad:
    - Si el usuario ya tiene rutinas, no toca nada.
    - La generación se realiza antes de insertar.
    - Si falta algún ejercicio, falla toda la operación.
    """

    if _get_user_routine_count(conn, user_id) > 0:
        return []

    catalog = _get_active_exercise_catalog(conn)

    if not catalog:
        raise ValueError(
            "El catálogo de ejercicios está vacío."
        )

    program = generate_engine_program(
        profile,
        catalog,
    )

    if not program.sessions:
        raise ValueError(
            "El motor no ha podido generar ninguna sesión."
        )

    exercise_ids = _get_exercise_ids(conn)

    created_routines: list[str] = []

    for day_order, session in enumerate(
        program.sessions,
        start=1,
    ):
        routine_id = str(uuid.uuid4())

        # El nombre visible será A, B, C...
        routine_name = chr(64 + day_order)

        conn.execute(
            """
            INSERT INTO routines (
                id,
                user_id,
                name,
                day_order,
                is_active
            )
            VALUES (?, ?, ?, ?, 1)
            """,
            (
                routine_id,
                user_id,
                routine_name,
                day_order,
            ),
        )

        for order, exercise in enumerate(
            session.exercises,
            start=1,
        ):
            exercise_id = exercise_ids.get(
                exercise.exercise_name
            )

            if exercise_id is None:
                raise ValueError(
                    "El motor ha seleccionado un ejercicio "
                    f"que no existe en el catálogo: "
                    f"{exercise.exercise_name}"
                )

            conn.execute(
                """
                INSERT INTO routine_exercises (
                    id,
                    routine_id,
                    exercise_id,
                    "order",
                    target_sets,
                    target_rep_min,
                    target_rep_max,
                    target_rir,
                    rest_seconds,
                    is_optional
                )
                VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
                """,
                (
                    str(uuid.uuid4()),
                    routine_id,
                    exercise_id,
                    order,
                    exercise.target_sets,
                    exercise.rep_min,
                    exercise.rep_max,
                    exercise.rir,
                    exercise.rest_seconds,
                    0,
                ),
            )

        created_routines.append(routine_id)

    return created_routines


def save_training_profile(
    conn,
    user_id: str,
    answers: dict[str, str],
) -> dict:
    """
    Guarda o actualiza el perfil de entrenamiento generado
    por el cuestionario inicial.
    """

    profile = build_training_profile(answers)
    program_id = select_program(profile)

    now = utc_now_iso()
    profile_id = create_onboarding_id()

    answers_json = json.dumps(
        answers,
        ensure_ascii=False,
        sort_keys=True,
    )

    existing = conn.execute(
        """
        SELECT id
        FROM user_training_profiles
        WHERE user_id = ?
        """,
        (user_id,),
    ).fetchone()

    if existing:
        conn.execute(
            """
            UPDATE user_training_profiles
            SET
                assessment_version = ?,
                goal = ?,
                experience = ?,
                days_per_week = ?,
                duration = ?,
                priority = ?,
                style = ?,
                answers_json = ?,
                program_id = ?,
                updated_at = ?
            WHERE user_id = ?
            """,
            (
                ASSESSMENT_VERSION,
                profile.goal,
                profile.experience,
                profile.days_per_week,
                profile.duration,
                profile.priority,
                profile.style,
                answers_json,
                program_id,
                now,
                user_id,
            ),
        )

        profile_id = existing["id"]

    else:
        conn.execute(
            """
            INSERT INTO user_training_profiles (
                id,
                user_id,
                assessment_version,
                goal,
                experience,
                days_per_week,
                duration,
                priority,
                style,
                answers_json,
                program_id,
                created_at,
                updated_at
            )
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
            """,
            (
                profile_id,
                user_id,
                ASSESSMENT_VERSION,
                profile.goal,
                profile.experience,
                profile.days_per_week,
                profile.duration,
                profile.priority,
                profile.style,
                answers_json,
                program_id,
                now,
                now,
            ),
        )

    return {
        "id": profile_id,
        "user_id": user_id,
        "assessment_version": ASSESSMENT_VERSION,
        "goal": profile.goal,
        "experience": profile.experience,
        "days_per_week": profile.days_per_week,
        "duration": profile.duration,
        "priority": profile.priority,
        "style": profile.style,
        "answers": answers,
        "program_id": program_id,
        "program_explanation": explain_selection(
            profile,
            program_id,
        ),
    }


def get_training_profile(conn, user_id: str) -> dict | None:
    row = conn.execute(
        """
        SELECT
            id,
            user_id,
            assessment_version,
            goal,
            experience,
            days_per_week,
            duration,
            priority,
            style,
            answers_json,
            program_id,
            created_at,
            updated_at
        FROM user_training_profiles
        WHERE user_id = ?
        """,
        (user_id,),
    ).fetchone()

    if row is None:
        return None

    try:
        answers = json.loads(row["answers_json"])
    except (TypeError, ValueError, json.JSONDecodeError):
        answers = {}

    return {
        "id": row["id"],
        "user_id": row["user_id"],
        "assessment_version": row["assessment_version"],
        "goal": row["goal"],
        "experience": row["experience"],
        "days_per_week": row["days_per_week"],
        "duration": row["duration"],
        "priority": row["priority"],
        "style": row["style"],
        "answers": answers,
        "program_id": row["program_id"],
        "created_at": row["created_at"],
        "updated_at": row["updated_at"],
    }
