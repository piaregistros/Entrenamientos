def validate_catalog(exercises: list[dict]) -> None:
    required = {
        "name",
        "target_muscle",
        "category",
        "equipment",
        "movement_pattern",
        "secondary_muscles",
        "exercise_type",
        "difficulty",
        "laterality",
    }

    names = set()

    for exercise in exercises:
        missing = required - exercise.keys()

        if missing:
            raise ValueError(
                f"{exercise.get('name', '<sin nombre>')}: "
                f"faltan campos {sorted(missing)}"
            )

        name = exercise["name"]

        if name in names:
            raise ValueError(f"Ejercicio duplicado: {name}")

        names.add(name)


def upsert_catalog(conn: sqlite3.Connection, exercises: list[dict]) -> None:
    for exercise in exercises:
        existing = conn.execute(
            "SELECT id FROM exercises WHERE name = ?",
            (exercise["name"],),
        ).fetchone()

        if existing:
            exercise_id = existing[0]

            conn.execute(
                """
                UPDATE exercises
                SET target_muscle = ?,
                    category = ?,
                    equipment = ?,
                    movement_pattern = ?,
                    secondary_muscles = ?,
                    exercise_type = ?,
                    difficulty = ?,
                    laterality = ?,
                    is_active = 1
                WHERE id = ?
                """,
                (
                    exercise["target_muscle"],
                    exercise["category"],
                    exercise["equipment"],
                    exercise["movement_pattern"],
                    exercise["secondary_muscles"],
                    exercise["exercise_type"],
                    exercise["difficulty"],
                    exercise["laterality"],
                    exercise_id,
                ),
            )
        else:
            conn.execute(
                """
                INSERT INTO exercises (
                    id,
                    name,
                    target_muscle,
                    category,
                    equipment,
                    is_active,
                    movement_pattern,
                    secondary_muscles,
                    exercise_type,
                    difficulty,
                    laterality
                )
                VALUES (?, ?, ?, ?, ?, 1, ?, ?, ?, ?, ?)
                """,
                (
                    str(uuid.uuid4()),
                    exercise["name"],
                    exercise["target_muscle"],
                    exercise["category"],
                    exercise["equipment"],
                    exercise["movement_pattern"],
                    exercise["secondary_muscles"],
                    exercise["exercise_type"],
                    exercise["difficulty"],
                    exercise["laterality"],
                ),
            )


def main() -> None:
    validate_catalog(EXERCISES)

    conn = sqlite3.connect(DB_PATH)

    try:
        upsert_catalog(conn, EXERCISES)
        conn.commit()
    except Exception:
        conn.rollback()
        raise
    finally:
        conn.close()

    print(f"Catálogo validado: {len(EXERCISES)} ejercicios")


if __name__ == "__main__":
    main()
