def validate_catalog(exercises: list[dict]) -> None:
    required = {"name","target_muscle","category","equipment","movement_pattern","secondary_muscles","exercise_type","difficulty","laterality"}
    names=[]
    for e in exercises:
        missing=required-set(e)
        if missing: raise ValueError(f"Campos faltantes en {e.get(\"name\")}: {missing}")
        names.append(e["name"])
    if len(names)!=len(set(names)): raise ValueError("Hay ejercicios duplicados")

def upsert_catalog(exercises: list[dict]) -> None:
    validate_catalog(exercises)
    conn=get_db_connection()
    try:
        for e in exercises:
            existing=conn.execute("SELECT id FROM exercises WHERE name=?",(e["name"],)).fetchone()
            if existing:
                conn.execute("UPDATE exercises SET target_muscle=?,category=?,equipment=?,movement_pattern=?,secondary_muscles=?,exercise_type=?,difficulty=?,laterality=?,is_active=1 WHERE id=?",(e["target_muscle"],e["category"],e["equipment"],e["movement_pattern"],e["secondary_muscles"],e["exercise_type"],e["difficulty"],e["laterality"],existing[0]))
            else:
                conn.execute("INSERT INTO exercises (id,name,target_muscle,category,equipment,movement_pattern,secondary_muscles,exercise_type,difficulty,laterality,is_active) VALUES (?,?,?,?,?,?,?,?,?,?,1)",(e.get("id") or __import__("uuid").uuid4().__str__(),e["name"],e["target_muscle"],e["category"],e["equipment"],e["movement_pattern"],e["secondary_muscles"],e["exercise_type"],e["difficulty"],e["laterality"]))
        conn.commit()
    finally:
        conn.close()

if __name__ == "__main__":
    validate_catalog(EXERCISES)
    print(f"Catálogo validado: {len(EXERCISES)} ejercicios")
    upsert_catalog(EXERCISES)
    print("Catálogo aplicado correctamente.")
