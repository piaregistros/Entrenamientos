@dataclass
class Candidate:
    id: str
    name: str
    muscle: str
    pattern: str
    category: str
    difficulty: str
    laterality: str
    raw: dict


@dataclass
class PlannedExercise:
    exercise_id: str
    name: str
    target_muscle: str
    movement_pattern: str
    sets: int
    rep_min: int
    rep_max: int
    rir: int
    rest_seconds: int
    rationale: str = ""


@dataclass
class Session:
    name: str
    exercises: list[PlannedExercise] = field(default_factory=list)

    @property
    def total_sets(self):
        return sum(x.sets for x in self.exercises)


@dataclass
class EngineProgram:
    program_id: str
    sessions: list[Session]
    weekly_sets: dict[str, int]
    evidence_notes: list[str] = field(default_factory=list)


def _norm(value):
    return str(value or "").strip().lower()


def _profile(profile, key, default=None):
    return getattr(profile, key, default)


def _catalog(rows):
    result = []

    for row in rows:
        target = str(row.get("target_muscle", ""))
        raw_pattern = str(row.get("movement_pattern", ""))

        result.append(
            Candidate(
                id=str(row["id"]),
                name=str(row["name"]),
                muscle=MUSCLE_MAP.get(target, _norm(target)),
                pattern=PATTERN_MAP.get(
                    raw_pattern,
                    _norm(raw_pattern),
                ),
                category=str(row.get("category", "")),
                difficulty=str(
                    row.get("difficulty", "principiante")
                ),
                laterality=str(
                    row.get("laterality", "bilateral")
                ),
                raw=row,
            )
        )

    return result


def _sessions(profile):
    days = _profile(
        profile,
        "days_per_week",
        _profile(profile, "days", 3),
    )
    return max(2, min(4, int(days)))


def _exercise_limit(profile):
    duration = str(
        _profile(profile, "duration", "60")
    )

    return {
        "30": 4,
        "45": 5,
        "60": 6,
        "75": 8,
    }.get(duration, 6)


def _difficulty_rank(value):
    value = _norm(value)

    if value in {"principiante", "beginner"}:
        return 1

    if value in {"intermedio", "intermediate"}:
        return 2

    return 3


def _candidate_matches(candidate, slot):
    wanted_muscles = set(slot.get("muscles", []))
    wanted_patterns = set(slot.get("patterns", []))

    if wanted_muscles and candidate.muscle in wanted_muscles:
        return True

    if wanted_patterns and candidate.pattern in wanted_patterns:
        return True

    if slot.get("allow_related"):
        if "glutes" in wanted_muscles and candidate.muscle in {
            "quads_glutes",
            "ham_glutes",
        }:
            return True

        if "quads" in wanted_muscles and candidate.muscle == "quads_glutes":
            return True

        if "hamstrings" in wanted_muscles and candidate.muscle == "ham_glutes":
            return True

    return False


def _candidate_score(candidate, slot, profile, used_names, used_patterns):
    score = 0
    experience = _norm(
        _profile(profile, "experience", "intermediate")
    )
    goal = _norm(
        _profile(profile, "goal", "hypertrophy")
    )

    if candidate.name in used_names:
        return -10000

    if candidate.pattern in used_patterns:
        score -= 30

    if candidate.pattern in slot.get("patterns", []):
        score += 100

    if candidate.muscle in slot.get("muscles", []):
        score += 80

    if slot.get("compound") is True:
        if candidate.category == "compuesto":
            score += 35
        else:
            score -= 20

    if slot.get("isolation") is True:
        if candidate.category == "aislamiento":
            score += 30

    if experience == "beginner":
        rank = _difficulty_rank(candidate.difficulty)
        score += 25 if rank == 1 else -20

    elif experience == "advanced":
        if _difficulty_rank(candidate.difficulty) >= 2:
            score += 10

    if goal == "strength" and candidate.category == "compuesto":
        score += 40

    if goal == "glutes":
        if candidate.pattern == "hip_extension":
            score += 35
        elif candidate.pattern == "hinge":
            score += 25
        elif candidate.pattern == "unilateral_leg":
            score += 15

    if candidate.laterality == "unilateral":
        score -= 2

    return score


def _choose_slot(candidates, slot, profile, used_names, used_patterns):
    pool = [
        c
        for c in candidates
        if _candidate_matches(c, slot)
    ]

    if not pool:
        return None

    return max(
        pool,
        key=lambda c: _candidate_score(
            c,
            slot,
            profile,
            used_names,
            used_patterns,
        ),
    )


def _prescription(candidate, goal, slot=None):
    compound = candidate.category == "compuesto"

    if goal == "strength":
        if compound:
            return 3, 5, 8, 2, 150
        return 2, 8, 12, 2, 90

    if goal == "glutes":
        if candidate.pattern in {
            "hip_extension",
            "hinge",
            "squat",
            "unilateral_leg",
        } and compound:
            return 3, 8, 12, 2, 120
        return 2, 10, 15, 2, 75

    if compound:
        return 3, 8, 12, 2, 120

    return 2, 10, 15, 2, 75


def _reason(candidate, goal, slot):
    role = slot.get("role", "complementario")
    pattern = candidate.pattern

    if goal == "strength":
        return (
            f"{candidate.name} se utiliza como {role} mediante "
            f"{pattern}. Al buscar fuerza se priorizan movimientos "
            "compuestos y rangos de 5-8 repeticiones, con descansos "
            "largos para limitar la pérdida de rendimiento entre series."
        )

    if goal == "glutes":
        return (
            f"{candidate.name} se utiliza como {role} para aumentar "
            f"el estímulo de glúteos mediante {pattern}. La sesión "
            "combina extensión de cadera, trabajo de rodilla y "
            "aislamiento para distribuir el estímulo y la fatiga."
        )

    return (
        f"{candidate.name} se utiliza como {role} mediante "
        f"{pattern}. La selección busca cubrir diferentes patrones "
        "de movimiento y repartir el volumen semanal entre sesiones."
    )


def _add_exercise(
    session,
    candidate,
    profile,
    goal,
    slot,
    used_names,
    used_patterns,
):
    if candidate is None:
        return False

    if candidate.name in used_names:
        return False

    sets, rep_min, rep_max, rir, rest = _prescription(
        candidate,
        goal,
        slot,
    )

    session.exercises.append(
        PlannedExercise(
            exercise_id=candidate.id,
            name=candidate.name,
            target_muscle=candidate.raw.get(
                "target_muscle",
                "",
            ),
            movement_pattern=candidate.raw.get(
                "movement_pattern",
                "",
            ),
            sets=sets,
            rep_min=rep_min,
            rep_max=rep_max,
            rir=rir,
            rest_seconds=rest,
            rationale=_reason(
                candidate,
                goal,
                slot,
            ),
        )
    )

    used_names.add(candidate.name)
    used_patterns.add(candidate.pattern)

    return True


def _slot(
    patterns=None,
    muscles=None,
    role="complementario",
    compound=False,
    isolation=False,
    allow_related=False,
):
    return {
        "patterns": patterns or [],
        "muscles": muscles or [],
        "role": role,
        "compound": compound,
        "isolation": isolation,
        "allow_related": allow_related,
    }


