def _muscle_key(candidate):
    if candidate.muscle in {"quads_glutes"}:
        return "glutes"
    if candidate.muscle in {"ham_glutes"}:
        return "hamstrings"
    if candidate.muscle in {"upper_chest"}:
        return "chest"
    if candidate.muscle in {"lateral_delts", "rear_delts"}:
        return "delts"
    return candidate.muscle


def _calculate_volume(sessions):
    result = {}

    for session in sessions:
        for exercise in session.exercises:
            muscle = MUSCLE_MAP.get(
                exercise.target_muscle,
                _norm(exercise.target_muscle),
            )

            if muscle == "quads_glutes":
                result["quads"] = result.get("quads", 0) + exercise.sets
                result["glutes"] = result.get("glutes", 0) + exercise.sets
            elif muscle == "ham_glutes":
                result["hamstrings"] = result.get("hamstrings", 0) + exercise.sets
                result["glutes"] = result.get("glutes", 0) + exercise.sets
            elif muscle == "upper_chest":
                result["chest"] = result.get("chest", 0) + exercise.sets
            elif muscle in {"lateral_delts", "rear_delts"}:
                result["delts"] = result.get("delts", 0) + exercise.sets
            else:
                result[muscle] = result.get(muscle, 0) + exercise.sets

    return result


def _evidence(goal):
    notes = [
        (
            "El programa distribuye el trabajo semanal entre varias "
            "sesiones para favorecer la calidad de las series y la recuperación."
        ),
        (
            "Se utiliza normalmente RIR 2 como punto de partida: "
            "permite entrenar cerca del fallo sin exigir fallo muscular "
            "sistemático en todas las series."
        ),
        (
            "Los ejercicios compuestos utilizan descansos más largos "
            "para reducir la pérdida de rendimiento entre series."
        ),
        (
            "La selección prioriza cubrir diferentes patrones de movimiento "
            "antes de añadir volumen accesorio."
        ),
        (
            "La hipertrofia puede lograrse con diferentes rangos de carga; "
            "el motor utiliza rangos moderados y ajusta la prescripción al objetivo."
        ),
    ]

    if goal == "strength":
        notes.append(
            "En fuerza se priorizan ejercicios compuestos, rangos de "
            "5-8 repeticiones y descansos de aproximadamente 150 segundos."
        )

    if goal == "glutes":
        notes.append(
            "En el objetivo glúteos se priorizan extensión de cadera, "
            "bisagra y trabajo unilateral, complementados con aislamiento."
        )

    return notes


def _validate_program(program, limit):
    assert program.sessions

    for session in program.sessions:
        assert 1 <= len(session.exercises) <= limit
        names = [x.name for x in session.exercises]
        assert len(names) == len(set(names))

        for exercise in session.exercises:
            assert exercise.sets > 0
            assert exercise.rep_min > 0
            assert exercise.rep_max >= exercise.rep_min
            assert 0 <= exercise.rir <= 5
            assert exercise.rest_seconds >= 45
            assert exercise.rationale


def generate_engine_program(profile, catalog):
    candidates = _catalog(catalog)

    days = _sessions(profile)
    limit = _exercise_limit(profile)

    goal = _norm(
        _profile(profile, "goal", "hypertrophy")
    )
    priority = _norm(
        _profile(profile, "priority", "balanced")
    )

    if goal == "strength":
        program_id = f"strength_{days}"
    elif goal == "glutes" or priority == "glutes":
        program_id = f"glutes_{days}"
    elif _norm(_profile(profile, "experience", "")) == "beginner":
        program_id = f"beginner_{days}_full_body"
    elif days >= 4:
        program_id = "upper_lower_4"
    else:
        program_id = "hypertrophy_3"

    templates = _templates(profile, goal, days)

    sessions = [
        Session(f"Día {chr(65 + i)}")
        for i in range(days)
    ]

    global_used = set()

    for index, session in enumerate(sessions):
        slots = templates[index % len(templates)]
        used_names = set()
        used_patterns = set()

        for slot in slots:
            if len(session.exercises) >= limit:
                break

            candidate = _choose_slot(
                candidates,
                slot,
                profile,
                used_names,
                used_patterns,
            )

            if candidate is None:
                continue

            added = _add_exercise(
                session,
                candidate,
                profile,
                goal,
                slot,
                used_names,
                used_patterns,
            )

            if added:
                global_used.add(candidate.name)

        # Segundo pase: completar la sesión si el catálogo permite hacerlo.
        if len(session.exercises) < min(limit, len(slots)):
            remaining = [
                c
                for c in candidates
                if c.name not in used_names
            ]

            remaining.sort(
                key=lambda c: (
                    c.name in global_used,
                    c.category != "compuesto",
                    c.pattern in used_patterns,
                )
            )

            for candidate in remaining:
                if len(session.exercises) >= limit:
                    break

                if candidate.pattern in used_patterns:
                    continue

                slot = _slot(
                    muscles=[_muscle_key(candidate)],
                    role="complementario",
                    compound=candidate.category == "compuesto",
                    isolation=candidate.category == "aislamiento",
                )

                if _add_exercise(
                    session,
                    candidate,
                    profile,
                    goal,
                    slot,
                    used_names,
                    used_patterns,
                ):
                    break

    weekly_sets = _calculate_volume(sessions)

    program = EngineProgram(
        program_id=program_id,
        sessions=sessions,
        weekly_sets=weekly_sets,
        evidence_notes=_evidence(goal),
    )

    _validate_program(program, limit)

    return program


def proposal_to_dict(program):
    return {
        "program_id": program.program_id,
        "sessions": [
            {
                "name": session.name,
                "total_sets": session.total_sets,
                "exercises": [
                    {
                        "exercise_id": exercise.exercise_id,
                        "name": exercise.name,
                        "target_muscle": exercise.target_muscle,
                        "movement_pattern": exercise.movement_pattern,
                        "sets": exercise.sets,
                        "rep_min": exercise.rep_min,
                        "rep_max": exercise.rep_max,
                        "rir": exercise.rir,
                        "rest_seconds": exercise.rest_seconds,
                        "rationale": exercise.rationale,
                    }
                    for exercise in session.exercises
                ],
            }
            for session in program.sessions
        ],
        "weekly_sets": program.weekly_sets,
        "evidence_notes": program.evidence_notes,
    }
