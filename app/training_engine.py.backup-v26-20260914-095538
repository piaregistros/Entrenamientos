                role="segundo empuje",
                compound=True,
            ),
            _slot(
                patterns=["vertical_pull"],
                muscles=["back"],
                role="segundo tirón vertical",
                compound=True,
            ),
            _slot(
                patterns=["hinge"],
                muscles=["hamstrings", "ham_glutes"],
                role="segunda bisagra",
                compound=True,
                allow_related=True,
            ),
            _slot(
                patterns=["rear_delt"],
                muscles=["rear_delts"],
                role="deltoides posterior",
                isolation=True,
            ),
            _slot(
                patterns=["shoulder_abduction"],
                muscles=["lateral_delts"],
                role="deltoides lateral",
                isolation=True,
            ),
        ],
    ][:days]


def _muscle_key(candidate):
    if candidate.muscle in {"quads_glutes"}:
        return "glutes"
    if candidate.muscle in {"ham_glutes"}:
        return "hamstrings"
    if candidate.muscle in {"upper_chest"}:
        return "chest"
    if candidate.muscle in {"lateral_delts", "rear_delts"}:
        return "delts"
    return candidate.muscle


def _calculate_volume(sessions):
    """
    Calcula el volumen semanal del programa.

    weekly_sets:
        Series del músculo primario declarado por el catálogo.

    effective_sets:
        Estimación conservadora que añade una fracción del trabajo
        indirecto de músculos secundarios. Se mantiene separada para
        no confundir volumen directo con volumen total estimado.
    """
    direct = {}
    effective = {}

    aliases = {
        "quads_glutes": "quads",
        "ham_glutes": "hamstrings",
        "upper_chest": "chest",
        "lateral_delts": "delts",
        "rear_delts": "delts",
    }

    secondary_aliases = {
        "quads_glutes": ("quads", "glutes"),
        "ham_glutes": ("hamstrings", "glutes"),
        "upper_chest": ("chest",),
        "lateral_delts": ("delts",),
        "rear_delts": ("delts",),
    }

    for session in sessions:
        for exercise in session.exercises:
            muscle = MUSCLE_MAP.get(
                exercise.target_muscle,
                _norm(exercise.target_muscle),
            )

            primary = aliases.get(muscle, muscle)

            direct[primary] = (
                direct.get(primary, 0) + exercise.sets
            )

            effective[primary] = (
                effective.get(primary, 0) + exercise.sets
            )

            for secondary in secondary_aliases.get(muscle, ()):
                if secondary != primary:
                    effective[secondary] = (
                        effective.get(secondary, 0)
                        + round(exercise.sets * 0.5, 1)
                    )

    return direct, effective


