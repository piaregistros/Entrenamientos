        )

    return notes


def _validate_program(program, limit):
    assert program.sessions

    for session in program.sessions:
        assert 1 <= len(session.exercises) <= limit
        names = [x.name for x in session.exercises]
        assert len(names) == len(set(names))

        for exercise in session.exercises:
            assert exercise.sets > 0
            assert exercise.rep_min > 0
            assert exercise.rep_max >= exercise.rep_min
            assert 0 <= exercise.rir <= 5
            assert exercise.rest_seconds >= 45
            assert exercise.rationale


def generate_engine_program(profile, catalog):
    candidates = _catalog(catalog)

    days = _sessions(profile)
    limit = _exercise_limit(profile)

    goal = _norm(
        _profile(profile, "goal", "hypertrophy")
    )
    priority = _norm(
        _profile(profile, "priority", "balanced")
    )

    if goal == "strength":
        program_id = f"strength_{days}"
    elif goal == "glutes" or priority == "glutes":
        program_id = f"glutes_{days}"
    elif _norm(_profile(profile, "experience", "")) == "beginner":
        program_id = f"beginner_{days}_full_body"
    elif days >= 4:
        program_id = "upper_lower_4"
    else:
        program_id = "hypertrophy_3"

    templates = _templates(profile, goal, days)

    sessions = [
        Session(f"Día {chr(65 + i)}")
        for i in range(days)
    ]

    global_used = set()

    for index, session in enumerate(sessions):
        slots = templates[index % len(templates)]
        used_names = set()
        used_patterns = set()

        for slot in slots:
            if len(session.exercises) >= limit:
                break

            candidate = _choose_slot(
                candidates,
                slot,
                profile,
                used_names,
                used_patterns,
                global_used,
            )

            if candidate is None:
                continue

            added = _add_exercise(
                session,
                candidate,
                profile,
                goal,
                slot,
                used_names,
                used_patterns,
            )

            if added:
                global_used.add(candidate.name)

        # Segundo pase: completar la sesión si el catálogo permite hacerlo.
        if len(session.exercises) < min(limit, len(slots)):
            remaining = [
                c
                for c in candidates
                if c.name not in used_names
            ]

            remaining.sort(
                key=lambda c: (
                    c.name in global_used,
                    c.category != "compuesto",
                    c.pattern in used_patterns,
                )
            )

            for candidate in remaining:
                if len(session.exercises) >= limit:
                    break

                if candidate.pattern in used_patterns:
                    continue

                slot = _slot(
                    muscles=[_muscle_key(candidate)],
                    role="complementario",
                    compound=_is_compound(candidate),
                    isolation=not _is_compound(candidate),
                )

                if _add_exercise(
                    session,
                    candidate,
                    profile,
                    goal,
                    slot,
                    used_names,
                    used_patterns,
                ):
                    break

    weekly_sets, effective_sets = _calculate_volume(sessions)

    volume_report = _validate_volume(
        profile,
        goal,
        weekly_sets,
    )

    program = EngineProgram(
        program_id=program_id,
        sessions=sessions,
        weekly_sets=weekly_sets,
        evidence_notes=_evidence(goal),
    )

    # Metadatos adicionales sin romper la API actual de EngineProgram.
    program.effective_sets = effective_sets
    program.volume_report = volume_report

    _validate_program(program, limit)

    return program


def proposal_to_dict(program):
    return {
        "program_id": program.program_id,
        "sessions": [
            {
                "name": session.name,
                "total_sets": session.total_sets,
                "exercises": [
                    {
                        "exercise_id": exercise.exercise_id,
                        "name": exercise.name,
                        "target_muscle": exercise.target_muscle,
                        "movement_pattern": exercise.movement_pattern,
                        "sets": exercise.sets,
                        "rep_min": exercise.rep_min,
                        "rep_max": exercise.rep_max,
                        "rir": exercise.rir,
                        "rest_seconds": exercise.rest_seconds,
                        "rationale": exercise.rationale,
                    }
                    for exercise in session.exercises
                ],
            }
            for session in program.sessions
        ],
        "weekly_sets": program.weekly_sets,
        "effective_sets": getattr(
            program,
            "effective_sets",
            {},
        ),
        "volume_report": getattr(
            program,
            "volume_report",
            {},
        ),
        "evidence_notes": program.evidence_notes,
    }
