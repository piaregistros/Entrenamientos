def _volume_targets(profile, goal):
    experience = _norm(
        _profile(profile, "experience", "intermediate")
    )

    if experience == "beginner":
        return BEGINNER_VOLUME_TARGETS

    return VOLUME_TARGETS.get(
        goal,
        VOLUME_TARGETS["general"],
    )


def _validate_volume(profile, goal, weekly_sets):
    """
    Devuelve un informe de volumen.

    No rechaza automáticamente un programa por quedar fuera del rango:
    sirve como capa de control para que una siguiente iteración pueda
    corregir el programa sin ocultar información al usuario.
    """
    targets = _volume_targets(profile, goal)

    report = {}

    for muscle, (low, high) in targets.items():
        actual = weekly_sets.get(muscle, 0)

        if actual < low:
            status = "below"
        elif actual > high:
            status = "above"
        else:
            status = "ok"

        report[muscle] = {
            "sets": actual,
            "target_min": low,
            "target_max": high,
            "status": status,
        }

    return report


