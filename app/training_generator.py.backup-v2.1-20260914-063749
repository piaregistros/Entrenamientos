def generate_program(
    profile: TrainingProfile,
    catalog: Iterable[dict],
) -> list[RoutineProposal]:
    catalog_by_name = _catalog_by_name(catalog)

    program_id = select_program(profile)

    if program_id == "beginner_2_full_body":
        return _build_full_body(catalog_by_name, 2, profile)

    if program_id == "beginner_3_full_body":
        return _build_full_body(catalog_by_name, 3, profile)

    if program_id == "glutes_3":
        return _build_glutes(catalog_by_name, 3, profile)

    if program_id == "glutes_4":
        return _build_glutes(catalog_by_name, 4, profile)

    if program_id == "strength_3":
        return _build_full_body(catalog_by_name, 3, profile)

    if program_id == "strength_4":
        return _build_upper_lower(catalog_by_name, profile)

    if program_id == "hypertrophy_3":
        return _build_full_body(catalog_by_name, 3, profile)

    if program_id == "upper_lower_4":
        return _build_upper_lower(catalog_by_name, profile)

    raise ValueError(f"Programa no soportado: {profile.program_id}")


def proposal_to_dict(proposal: RoutineProposal) -> dict:
    return {
        "name": proposal.name,
        "day_order": proposal.day_order,
        "exercises": [asdict(exercise) for exercise in proposal.exercises],
    }
