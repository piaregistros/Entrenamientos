from __future__ import annotations

from dataclasses import dataclass, asdict
from typing import Iterable
import random

from .training_assessment import TrainingProfile, select_program


@dataclass(frozen=True)
class ExercisePrescription:
    name: str
    exercise_id: str | None
    order: int
    target_sets: int
    target_rep_min: int
    target_rep_max: int
    target_rir: int
    rest_seconds: int
    is_optional: int = 0


@dataclass(frozen=True)
class RoutineProposal:
    name: str
    day_order: int
    exercises: tuple[ExercisePrescription, ...]


def _exercise(
    name: str,
    exercise_id: str | None,
    order: int,
    sets: int,
    reps: tuple[int, int],
    rir: int,
    rest: int,
) -> ExercisePrescription:
    return ExercisePrescription(
        name=name,
        exercise_id=exercise_id,
        order=order,
        target_sets=sets,
        target_rep_min=reps[0],
        target_rep_max=reps[1],
        target_rir=rir,
        rest_seconds=rest,
    )


def _catalog_by_name(catalog: Iterable[dict]) -> dict[str, dict]:
    return {exercise["name"]: exercise for exercise in catalog}


def _find_exercise(
    catalog: dict[str, dict],
    *,
    category: str | None = None,
    movement_pattern: str | None = None,
    target_muscles: tuple[str, ...] = (),
    difficulty: str | None = None,
    exclude: set[str] | None = None,
) -> dict | None:
    exclude = exclude or set()

    candidates = []
    for exercise in catalog.values():
        if exercise["name"] in exclude:
            continue
        if category and exercise["category"] != category:
            continue
        if movement_pattern and exercise["movement_pattern"] != movement_pattern:
            continue
        if difficulty and exercise["difficulty"] not in (difficulty, "principiante"):
            continue

        if target_muscles:
            target = exercise["target_muscle"].lower()
            secondary = exercise["secondary_muscles"].lower()
            if not any(
                muscle.lower() in target or muscle.lower() in secondary
                for muscle in target_muscles
            ):
                continue

        candidates.append(exercise)

    if not candidates:
        return None

    return candidates[0]


def _pick(
    catalog: dict[str, dict],
    preferred_names: tuple[str, ...],
    *,
    exclude: set[str],
) -> dict:
    for name in preferred_names:
        exercise = catalog.get(name)
        if exercise and name not in exclude:
            return exercise

    for exercise in catalog.values():
        if exercise["name"] not in exclude:
            return exercise

    raise ValueError("No quedan ejercicios disponibles en el catálogo")


def _prescription(
    exercise: dict,
    order: int,
    *,
    sets: int,
    reps: tuple[int, int],
    rir: int,
    rest: int,
) -> ExercisePrescription:
    return _exercise(
        exercise["name"],
        exercise.get("id"),
        order,
        sets,
        reps,
        rir,
        rest,
    )


def _build_full_body(
    catalog: dict[str, dict],
    day_count: int,
    profile: TrainingProfile,
) -> list[RoutineProposal]:
    routines = []

    patterns = [
        (
            ("Prensa de piernas", "Hack squat", "Sentadilla goblet"),
            ("Press banca plano", "Press banca con mancuernas"),
            ("Jalón al pecho agarre neutro", "Jalón al pecho agarre amplio"),
            ("Hip thrust", "Peso muerto rumano con mancuernas"),
            ("Curl femoral", "Curl femoral sentado"),
            ("Extensión de tríceps en polea", "Extensión de tríceps con cuerda"),
        ),
        (
            ("Sentadilla goblet", "Prensa de piernas", "Hack squat"),
            ("Press inclinado con mancuernas 30 grados", "Press inclinado en máquina"),
            ("Remo con pecho apoyado", "Remo sentado en polea"),
            ("Hip thrust", "Peso muerto rumano"),
            ("Elevaciones laterales en máquina", "Elevaciones laterales con mancuernas"),
            ("Curl de bíceps en máquina", "Curl con mancuernas"),
        ),
        (
            ("Sentadilla libre", "Prensa de piernas", "Hack squat"),
            ("Press banca con mancuernas", "Press banca plano"),
            ("Remo en máquina", "Remo unilateral con mancuerna"),
            ("Peso muerto rumano", "Hip thrust"),
            ("Curl femoral tumbado", "Curl femoral sentado"),
            ("Crunch en máquina", "Plancha"),
        ),
    ]

    for day in range(1, day_count + 1):
        selected: list[dict] = []
        used: set[str] = set()

        for choices in patterns[(day - 1) % len(patterns)]:
            exercise = _pick(catalog, choices, exclude=used)
            selected.append(exercise)
            used.add(exercise["name"])

        prescriptions = []
        for order, exercise in enumerate(selected, start=1):
            compound = exercise["exercise_type"] == "compuesto"

            if profile.goal == "strength":
                sets = 3 if compound else 2
                reps = (5, 8) if compound else (8, 12)
                rir = 2
                rest = 150 if compound else 90
            elif profile.goal == "glutes":
                sets = 3 if compound else 2
                reps = (8, 12) if compound else (10, 15)
                rir = 2
                rest = 120 if compound else 75
            else:
                sets = 3 if compound else 2
                reps = (8, 12) if compound else (10, 15)
                rir = 2
                rest = 120 if compound else 75

            prescriptions.append(
                _prescription(
                    exercise,
                    order,
                    sets=sets,
                    reps=reps,
                    rir=rir,
                    rest=rest,
                )
            )

        routines.append(
            RoutineProposal(
                name=chr(64 + day),
                day_order=day,
                exercises=tuple(prescriptions),
            )
        )

    return routines


