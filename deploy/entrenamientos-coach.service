[Unit]
Description=Entrenamientos Coach (Qwen)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/entrenamiento
EnvironmentFile=-/opt/entrenamiento/.coach.env
ExecStart=/usr/bin/python3 -m uvicorn coach_server:app --host 127.0.0.1 --port 8001
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
